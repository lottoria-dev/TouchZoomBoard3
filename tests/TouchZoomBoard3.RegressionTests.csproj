<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>Exe</OutputType>
    <AssemblyName>TouchZoomBoard3.RegressionTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
    <StartupObject>TouchZoomBoard.RegressionTests</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the production sources directly, without launching the app,
         changing real settings, installing hooks or adding a test dependency. -->
    <Compile Include="..\TouchZoomBoard3\*.cs" Exclude="..\TouchZoomBoard3\Program.cs" />
    <Compile Include="RegressionTests.cs" />
    <Resource Include="..\TouchZoomBoard3\TouchZoomBoard3.ico" Link="TouchZoomBoard3.ico" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
